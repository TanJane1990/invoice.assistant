{
  "appId": "com.invoice.assistant",
  "productName": "智能发票管理助手",
  "publish": null,
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "directories": {
    "output": "dist_electron"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "electron/**/*",
    "assets/**/*",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "dist/tessdata/**/*",
    "public/tessdata/**/*"
  ],
  "compression": "maximum",
  "electronVersion": "22.3.27",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ],
    "requestedExecutionLevel": "asInvoker",
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "智能发票管理助手",
    "uninstallDisplayName": "智能发票管理助手",
    "runAfterFinish": true,
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.business",
    "icon": "assets/icon.png",
    "identity": null,
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "Office",
    "icon": "assets/icon.png",
    "maintainer": "TanJane",
    "synopsis": "智能发票管理助手及报销排版打印工具",
    "description": "专为企业财务与个人报销设计的智能发票管理助手，支持增值税发票全票面OCR识别、PDF发票排版打印、A4一键拼页与发票台账Excel导出。",
    "desktop": {
      "StartupNotify": "true",
      "Encoding": "UTF-8",
      "MimeType": "application/pdf;image/png;image/jpeg;",
      "Categories": "Office;Finance;Utility;"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "deb": {
    "priority": "optional",
    "packageCategory": "utils",
    "compression": "xz"
  }
}
